from sklearn.model_selection import StratifiedKFold
import numpy as np
import pandas as pd

def make_submission(
    model,
    X_train,
    y_train,
    X_test,
    target_encoder=target_enc,
    sample_weight=None,
    k=5,
    filename="submission.csv",
    n_splits=5
):
    """
    Trains model with cross-validation on X_train using optional sample weights,
    generates OOF predictions, and averages predictions on X_test over folds
    to make final submission.

    Parameters
    ----------
    model : sklearn-like estimator (e.g., LGBMClassifier)
    X_train : array-like
    y_train : array-like
    X_test : array-like
    target_encoder : encoder with inverse_transform()
    sample_weight : array-like of shape (len(X_train),), optional
        Per-sample training weights. If None, all weights are equal.
    k : int
        Top-k predictions for submission.
    filename : str
        Output CSV filename.
    n_splits : int
        Number of cross-validation folds.
    """

    y_encoded = y_train.copy()
    sample_submission = pd.read_csv("/content/sample_submission.csv")

    skf = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=42)
    n_classes = len(np.unique(y_encoded))

    oof_preds = np.zeros((X_train.shape[0], n_classes))
    test_preds = np.zeros((X_test.shape[0], n_classes))

    for fold_idx, (train_idx, val_idx) in enumerate(skf.split(X_train, y_encoded)):
        print(f"Training fold {fold_idx + 1}/{n_splits}...")

        X_tr, X_val = X_train[train_idx], X_train[val_idx]
        y_tr, y_val = y_encoded[train_idx], y_encoded[val_idx]

        # Slice weights for the current training fold if provided
        w_tr = sample_weight[train_idx] if sample_weight is not None else None

        # Fit model with per-fold weights
        model.fit(X_tr, y_tr, sample_weight=w_tr)

        # OOF validation preds
        oof_preds[val_idx] = model.predict_proba(X_val)

        # Test preds (average over folds)
        test_preds += model.predict_proba(X_test) / n_splits

    # Top-k predictions from averaged test probabilities
    top_k_preds = np.argsort(test_preds, axis=1)[:, -k:][:, ::-1]

    # Decode class indices back to original labels
    n_samples, k_preds = top_k_preds.shape
    flattened_preds = top_k_preds.flatten().reshape(-1, 1)
    decoded_flat = target_encoder.inverse_transform(flattened_preds).ravel()
    top_k_labels = decoded_flat.reshape(n_samples, k_preds)

    # Format predictions
    preds_str = [" ".join(row.astype(str)) for row in top_k_labels]

    # Create submission
    submission = sample_submission.copy()
    submission["prognosis"] = preds_str
    submission.to_csv(filename, index=False)

    return submission

def cvs(model, X, y, target_encoder=target_enc, k=3, cv=5, random_state=42):
    """
    Performs cross-validation using MAP@k as scoring.
    """
    skf = StratifiedKFold(n_splits=cv, shuffle=True, random_state=random_state)
    scores = []

    X=check_array(X.copy())
    y=check_array(y.copy(),ensure_2d=False)


    for train_idx, val_idx in skf.split(X, y):
        X_train_fold, X_val_fold = X[train_idx], X[val_idx]
        y_train_fold, y_val_fold = y[train_idx], y[val_idx]

        model.fit(X_train_fold, y_train_fold)
        proba = model.predict_proba(X_val_fold)
        top_k_preds = np.argsort(proba, axis=1)[:, -k:][:, ::-1]

        # Decode top-k predictions column-by-column, then zip back to list-of-lists
        pred_labels = np.column_stack([
            target_encoder.inverse_transform(col.reshape(-1, 1)).ravel()
            for col in top_k_preds.T
        ])

        pred_labels = pred_labels.tolist()
        true_labels = target_encoder.inverse_transform(y_val_fold.reshape(-1, 1)).ravel()

        scores.append(mapk(true_labels, pred_labels, k=k))

    return np.mean(scores)