from sklearn.metrics import average_precision_score
from sklearn.preprocessing import OrdinalEncoder
import pandas as pd
import numpy as np

def preprocess_data(train_df, test_df, target_col='prognosis'):
    """
    Label encode categorical features and the target.
    Returns encoded train/test, y, and the fitted encoders.
    """
    X_train = train_df.drop(columns=[target_col])
    y_train = train_df[target_col]

    # Encode categorical features
    cat_cols = X_train.select_dtypes(include='object').columns
    feat_enc = OrdinalEncoder()
    X_train[cat_cols] = feat_enc.fit_transform(X_train[cat_cols])
    test_df[cat_cols] = feat_enc.transform(test_df[cat_cols])

    # Encode target
    target_enc = OrdinalEncoder()
    y_train = target_enc.fit_transform(y_train.values.reshape(-1, 1)).ravel()

    return X_train, test_df, pd.Series(y_train,index=X_train.index,name=target_col), feat_enc, target_enc

def mapk(actual, predicted, k=3):
    """
    Computes the mean average precision at k.
    `actual` should be a list of correct labels.
    `predicted` should be a list of predicted label lists.
    """
    def apk(a, p, k):
        if a in p[:k]:
            return 1 / (p[:k].index(a) + 1)
        return 0

    return np.mean([apk(a, p, k) for a, p in zip(actual, predicted)])

